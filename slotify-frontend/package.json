{
  "name": "slotify-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json ../.prettierrc.json",
    "format:backend": "prettier --write --config ../.prettierrc.json --plugin=prettier-plugin-java \"../slotify-backend/src/**/*.java\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json ../.prettierrc.json && prettier --check --config ../.prettierrc.json --plugin=prettier-plugin-java \"../slotify-backend/src/**/*.java\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
